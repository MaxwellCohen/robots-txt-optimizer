{
  "name": "@robots-txt-optimizer/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/fixtures"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./fetch": {
      "types": "./src/fetch/index.ts",
      "default": "./src/fetch/index.ts"
    },
    "./node": {
      "types": "./src/fetch/node.ts",
      "default": "./src/fetch/node.ts"
    },
    "./simulation-config": {
      "types": "./src/simulation-config.ts",
      "default": "./src/simulation-config.ts"
    },
    "./templates": {
      "types": "./src/templates.ts",
      "default": "./src/templates.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "robots-linter": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
